# Copied to .env by scripts/install.sh, which also fills the secrets.
# Keep .env: ENCRYPTION_KEY decrypts every credential AnythingMCP stores.
JWT_SECRET=
ENCRYPTION_KEY=

# First admin account, created by scripts/install.sh.
AMCP_ADMIN_EMAIL=
AMCP_ADMIN_PASSWORD=

# SAP Business One: fill these and re-run scripts/install.sh to install the connector.
SAP_B1_HOST=
SAP_B1_PORT=
SAP_B1_COMPANY_DB=
SAP_B1_USERNAME=
SAP_B1_PASSWORD=

# SAP S/4HANA Cloud: fill these and re-run scripts/install.sh to install the connector.
S4_BASE_URL=
S4_TOKEN_URL=
S4_CLIENT_ID=
S4_CLIENT_SECRET=

# SAP S/4HANA (OData): fill these and re-run scripts/install.sh to install the connector.
SAP_ODATA_BASE_URL=
SAP_CLIENT=
SAP_LANGUAGE=
SAP_ODATA_USER=
SAP_ODATA_PASSWORD=

# SAP S/4HANA (HANA SQL): fill these and re-run scripts/install.sh to install the connector.
SAP_HANA_HOST=
SAP_HANA_PORT=
SAP_HANA_TENANT=
SAP_HANA_SCHEMA=
SAP_CLIENT=
SAP_LANGUAGE=
SAP_HANA_TLS=
SAP_HANA_USER=
SAP_HANA_PASSWORD=

# SAP Concur: fill these and re-run scripts/install.sh to install the connector.
CONCUR_REGION=
CONCUR_CLIENT_ID=
CONCUR_CLIENT_SECRET=
CONCUR_REFRESH_TOKEN=

# Written by scripts/install.sh.
MCP_URL=
MCP_API_KEY=
